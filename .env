# --- Système (LinuxServer) ---
PUID=1000
PGID=1000
TZ=Europe/Paris

# --- NetBox : Administrateur ---
SUPERUSER_EMAIL=louismedo@ik.me
SUPERUSER_PASSWORD=changepassword

# --- NetBox : Sécurité & Réseau ---
SECRET_KEY=ChangeMe_RandomSecretKey_Replace_This_String_With_OpenSSL_Output
ALLOWED_HOST=ChangeIP # Exemple : 172.16.20.6 ou netbox.domaine.com
PROXY_ENABLED=false

# --- NetBox : Connexion Base de données ---
DB_HOST=netbox-db
DB_PORT=5432
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=ChangeMe_DbSecret_456!

# --- NetBox : Connexion Redis ---
REDIS_HOST=netbox-redis
REDIS_PORT=6379
REDIS_DB_TASK=0
REDIS_DB_CACHE=1

# --- PostgreSQL ---
POSTGRES_DB=netbox
POSTGRES_USER=netbox
POSTGRES_PASSWORD=ChangeMe_DbSecret_456!